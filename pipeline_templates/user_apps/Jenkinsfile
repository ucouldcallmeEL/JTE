node {
    devflow_stage('Checkout') {
        env.GIT_COMMIT = git_checkout().GIT_COMMIT
    }
    devflow_stage('Lint') {
        lint()
    }
    devflow_stage('Build') {
        install_dependencies()
        sh 'echo "manager=$PYTHON_PACKAGE_MANAGER run=$PYTHON_RUN"; ls .venv/bin | head'   // debug, remove later
    }
    devflow_stage('Test') {
        unit_test()
    }
    devflow_stage('Security Scan') {
        gitleaks_scan()
        trivy_fs_scan()     // TODO semgrep_scan here too
    }
    devflow_stage('Package') {
        registry_login {        // Docker Hub for now; gcp's Artifact Registry later
            build_image()
            trivy_image_scan()   // gate: nothing is pushed unless this passes
            push_image()
        }
    }
    // TODO Deploy: run the image as a container on GCP once the account exists
}
